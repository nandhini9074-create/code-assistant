# ==============================================================================
# Code Explorer — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to git.
# ==============================================================================

# Application
APP_NAME=Code Explorer
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-use-a-random-256-bit-key

# PostgreSQL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_explorer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collection name used to store all code chunk vectors
QDRANT_COLLECTION_NAME=code_chunks

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_FILE_SIZE_MB=10

# Jina AI (Embedding)
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_BATCH_SIZE=32
JINA_MAX_RETRIES=3

# Qwen LLM
# Qwen via Alibaba Cloud DashScope (OpenAI-compatible endpoint)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAX_TOKENS=4096
QWEN_TEMPERATURE=0.1
QWEN_MAX_RETRIES=3
QWEN_TIMEOUT_SECONDS=60

# Embedding
EMBEDDING_DIMENSION=1024

# Ingestion
INGESTION_MAX_ZIP_SIZE_MB=500
INGESTION_MAX_ZIP_FILES=10000
INGESTION_CHUNK_MAX_TOKENS=512
INGESTION_CHUNK_OVERLAP_TOKENS=64

# Search
SEARCH_TOP_K=20
SEARCH_MIN_EVIDENCE_SCORE=0.5
SEARCH_MAX_CONTEXT_TOKENS=8192
